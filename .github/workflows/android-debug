# Builds a debug APK on every push and attaches it to the run.
# Download it from: GitHub repo > Actions tab > the latest run > "pathbound-debug-apk" under Artifacts.
name: Debug APK

on:
  push:
  workflow_dispatch:

jobs:
  apk:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21

      - name: Install packages
        run: npm ci

      - name: Check copy, content and types
        run: npm run validate

      - name: Self-test the validator and engine
        run: npm run selftest

      - name: Build the web bundle
        run: npm run build

      - name: Copy the bundle into the Android project
        run: npx cap sync android

      - name: Build the debug APK
        working-directory: android
        run: |
          # Zips made on Windows lose the executable bit, so set it here.
          chmod +x gradlew
          yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null || true
          ./gradlew assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: pathbound-debug-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
